__pycache__/
*.pyc
*.pyo
.DS_Store
logs/
# ...but the archived run logs ARE part of the record: results/server_archive/logs/ is the
# stdout of the server-era runs. A bare `logs/` rule silently dropped all 126 of them when
# the archive was first staged -- the same trap the results/ note below warns about.
!results/server_archive/logs/
*.egg-info/
.venv/
venv/

# Large local corpora (288 MB; re-downloadable, not part of the scientific record)
data/domains/

# NOTE: results/ is deliberately NOT ignored. The raw JSON of every archived run
# is the scientific record this project reasons from, it is small (~2 MB), and an
# earlier .gitignore rule silently kept all of it out of the repository.
